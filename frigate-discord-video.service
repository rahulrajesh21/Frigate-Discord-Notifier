[Unit]
Description=Frigate Discord Video Notification Service
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/frigate-discord-video
EnvironmentFile=-/path/to/frigate-discord-video/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /path/to/frigate-discord-video/server.py
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
