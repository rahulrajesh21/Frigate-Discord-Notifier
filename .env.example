# Frigate API URL (internal Docker network or host IP)
FRIGATE_URL=http://172.18.0.2:5000

# Webhook receiver port
PORT=5001

# Discord Webhook URL (required — set here or in ~/.notify-discord.json)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Retry configuration for clip readiness
MAX_RETRIES=15
RETRY_INTERVAL=4

# Maximum allowed MP4 upload size in MB (Discord standard webhook limit is 10MB)
# Clips exceeding this threshold are automatically split into lossless parts
MAX_FILE_SIZE_MB=9.5
