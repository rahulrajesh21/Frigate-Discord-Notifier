# Frigate API URL (internal Docker network or host IP)
FRIGATE_URL=http://172.18.0.3:5000

# Webhook receiver port
PORT=5001

# Optional: Override Discord webhook URL (otherwise uses ~/.notify-discord.json)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Retry configuration for clip readiness
MAX_RETRIES=15
RETRY_INTERVAL=4

# Maximum allowed MP4 upload size in MB (Discord standard limit is 25MB)
MAX_FILE_SIZE_MB=24.5
